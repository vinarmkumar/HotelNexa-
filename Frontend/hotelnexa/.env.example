VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# Leave empty for the local Vite proxy; set the HTTPS API origin when deploying.
VITE_API_URL=
# Optional map provider URLs; defaults use Photon and OpenStreetMap.
VITE_PHOTON_URL=https://photon.komoot.io/api/
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
